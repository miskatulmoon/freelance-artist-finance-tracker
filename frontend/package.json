{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "npx -y openapi-typescript@7.13.0 ../openapi.json -o src/types/api.d.ts",
    "bundlesize": "bundlesize"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "bundlesize": "^0.18.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "bundlesize": [
    {
      "path": "./dist/assets/*.js",
      "maxSize": "650 kB",
      "compression": "gzip"
    }
  ]
}
