            "type": "array",
            "title": "Monthly Trend"
          },
          "top_merchants": {
            "items": {
              "$ref": "#/components/schemas/MerchantTotal"
            },
            "type": "array",
            "title": "Top Merchants"
          },
          "total_fees": {
            "type": "number",
            "title": "Total Fees"
          },
          "hourly_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hourly Rate"
          }
        },
        "type": "object",
        "required": [
          "balance",
          "per_source_net",
          "monthly_trend",
          "top_merchants",
          "total_fees",
          "hourly_rate"
