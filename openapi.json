  "components": {
    "schemas": {
      "CashflowInsightsResponse": {
        "properties": {
          "radar": {
            "$ref": "#/components/schemas/CashflowRadarRead"
          },
          "narrative": {
            "type": "string",
            "title": "Narrative"
          }
        },
        "type": "object",
        "required": [
          "radar",
          "narrative"
        ],
        "title": "CashflowInsightsResponse"
      },
      "CashflowRadarRead": {
        "properties": {
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "burn_per_day": {
            "type": "number",
            "title": "Burn Per Day"
          },
          "burn_next_30d": {
            "type": "number",
            "title": "Burn Next 30D"
          },
          "committed_next_30d": {
            "type": "number",
            "title": "Committed Next 30D"
          },
          "projected_balance_30d": {
            "type": "number",
            "title": "Projected Balance 30D"
          },
          "coverage_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage Pct"
          },
          "level": {
            "type": "string",
            "enum": [
              "healthy",
              "moderate",
              "low",
              "unknown"
            ],
            "title": "Level"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "projection": {
            "items": {
              "$ref": "#/components/schemas/RadarPoint"
            },
            "type": "array",
            "title": "Projection"
          },
          "runway_days": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runway Days"
          },
          "projected_zero_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Projected Zero Date"
          }
        },
        "type": "object",
        "required": [
          "balance",
          "burn_per_day",
          "burn_next_30d",
          "committed_next_30d",
          "projected_balance_30d",
          "coverage_pct",
          "level",
          "as_of",
          "projection",
          "runway_days",
          "projected_zero_date"
        ],
        "title": "CashflowRadarRead"
      },
      "Category": {
        "type": "string",
        "enum": [
          "supplies",
          "platform_fees",
          "subscriptions",
          "equipment",
          "other_expense"
        ],
        "title": "Category"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "ChatResponse"
      },
      "CommissionCreate": {
        "properties": {
          "client": {
            "type": "string",
            "minLength": 1,
            "title": "Client"
          },
          "piece": {
            "type": "string",
            "minLength": 1,
            "title": "Piece"
          },
          "hours_spent": {
            "type": "number",
            "minimum": 0.0,
            "title": "Hours Spent",
            "default": 0
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "expected_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Date"
          },
          "status": {
            "$ref": "#/components/schemas/CommissionStatus",
            "default": "in_progress"
          },
          "transaction_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Id"
          }
        },
        "type": "object",
        "required": [
          "client",
          "piece"
        ],
        "title": "CommissionCreate",
        "description": "API boundary: accepts dollars, exposes integer cents to the domain."
      },
      "CommissionRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "client": {
            "type": "string",
            "title": "Client"
          },
          "piece": {
            "type": "string",
            "title": "Piece"
          },
          "hours_spent": {
            "type": "number",
            "title": "Hours Spent"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "expected_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Date"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "transaction_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Id"
          },
          "income_autologged": {
            "type": "boolean",
            "title": "Income Autologged"
          },
          "effective_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Rate"
          }
        },
        "type": "object",
        "required": [
          "id",
          "client",
          "piece",
          "hours_spent",
          "amount",
          "expected_date",
          "status",
          "transaction_id",
          "income_autologged",
          "effective_rate"
        ],
        "title": "CommissionRead"
      },
      "CommissionStatus": {
        "type": "string",
        "enum": [
          "agreed",
          "in_progress",
          "completed",
          "cancelled"
        ],
        "title": "CommissionStatus"
      },
      "CommissionSummary": {
        "properties": {
          "expected_income": {
            "type": "number",
            "title": "Expected Income"
          },
          "earned_income": {
            "type": "number",
            "title": "Earned Income"
          },
          "lost_income": {
            "type": "number",
            "title": "Lost Income"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Counts"
          },
          "active_count": {
            "type": "integer",
            "title": "Active Count"
          }
        },
        "type": "object",
        "required": [
          "expected_income",
          "earned_income",
          "lost_income",
          "counts",
          "active_count"
        ],
        "title": "CommissionSummary"
      },
      "CommissionUpdate": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CommissionStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CommissionUpdate",
        "description": "Terms (price, hours, expected date) lock when the commission is logged.\n\nOnly progress \u2014 the status \u2014 can be updated afterwards."
      },
      "DashboardSummary": {
        "properties": {
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "per_source_net": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Per Source Net"
          },
          "monthly_trend": {
            "items": {
              "$ref": "#/components/schemas/TrendPoint"
